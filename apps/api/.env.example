PORT=3000
MONGO_USER=ritual_app
MONGO_PASSWORD=
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DATABASE=ritual_coffee

# Autenticación: no modificar credenciales MongoDB para configurarla.
NODE_ENV=development
# Orígenes exactos separados por comas, sin barra final. HTTPS obligatorio en producción.
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# Vencimiento absoluto en segundos: 8 horas por defecto (rango permitido: 60–86400).
AUTH_SESSION_TTL_SECONDS=28800
